    for(i=0;i<12;++i){int col=i%3,row=i/3,label=i<9?i+1:(i==10?0:-1);char n[4];int x=m+col*(c->width-2*m)/3,y=top+px(c->width,260)+row*px(c->width,62);key=make_rect(x+px(c->width,7),y,((c->width-2*m)/3)-px(c->width,14),px(c->width,50));if(i==9){cer_draw_text_center(c,key.x+key.w/2,key.y+px(c->width,16),"CLEAR",px(c->width,12),muted());hit_add(a,HIT_PIN_DELETE,key);}else if(i==11){cer_draw_icon(c,CER_ICON_BACK,key.x+key.w/2,key.y+key.h/2,px(c->width,20),muted(),bg());hit_add(a,HIT_PIN_DELETE,key);}else{int_text(label,n,sizeof(n));cer_fill_round_rect(c,key.x,key.y,key.w,key.h,px(c->width,13),surface2());cer_draw_text_center(c,key.x+key.w/2,key.y+px(c->width,14),n,px(c->width,20),ink());hit_add(a,HIT_PIN_BASE+label,key);}}
