static void render_game_screen(App*a,CerCanvas*c,int puzzle){
    int m=px(c->width,10),top=topbar_h(c->width),rowh=px(c->width,56),toolbarh=px(c->width,61),statush=px(c->width,35),available,size,y,bottom_white=!a->flipped,top_white=!bottom_white,i;Rect r;char small[48];
    draw_topbar(a,c,puzzle?PUZZLES[a->puzzle_index].title:(a->game_mode==MODE_LOCAL?"PASS & PLAY":"VS STOCKFISH"),1,0);
    if(puzzle){r=make_rect(m,top+px(c->width,5),c->width-2*m,rowh);card(c,r,px(c->width,12),surface());pill(c,make_rect(r.x+px(c->width,10),r.y+px(c->width,11),px(c->width,72),px(c->width,30)),"PUZZLE",cer_rgba(83,64,112,255),ink());cer_draw_text(c,r.x+px(c->width,94),r.y+px(c->width,11),PUZZLES[a->puzzle_index].subtitle,px(c->width,12),ink());int_text(PUZZLES[a->puzzle_index].rating,small,sizeof(small));cer_draw_text(c,r.x+px(c->width,94),r.y+px(c->width,31),small,px(c->width,10),muted());}
    else draw_player_row(a,c,make_rect(m,top+px(c->width,5),c->width-2*m,rowh),top_white,1);
    available=c->height-(top+rowh+px(c->width,10))-rowh-toolbarh-statush-px(c->width,38);size=i_min(c->width-2*m,available);size=(size/8)*8;y=top+rowh+px(c->width,12);draw_board(a,c,&a->game,(c->width-size)/2,y,size,1);
    r=make_rect(m,y+size+px(c->width,10),c->width-2*m,rowh);if(puzzle){card(c,r,px(c->width,12),surface());cer_draw_text(c,r.x+px(c->width,14),r.y+px(c->width,10),a->puzzle_complete?"SOLVED":"YOUR MOVE",px(c->width,16),a->puzzle_complete?mint():ink());cer_draw_text(c,r.x+px(c->width,14),r.y+px(c->width,32),a->puzzle_complete?"Tap next from the menu or replay it.":"Find the forcing move.",px(c->width,10),muted());}
    else draw_player_row(a,c,r,bottom_white,0);
    r=make_rect(m,y+size+rowh+px(c->width,17),c->width-2*m,statush);pill(c,r,a->status,a->game_over&&a->result_reason==REASON_MATE?red_dim():(a->in_check?cer_rgba(115,71,31,255):surface2()),a->game_over&&a->result_reason==REASON_MATE?cer_rgba(255,204,207,255):(a->in_check?cer_rgba(255,211,162,255):ink()));
    {int gap=px(c->width,5),w=(c->width-2*m-gap*4)/5,ty=c->height-toolbarh-px(c->width,7);for(i=0;i<5;++i){Rect t=make_rect(m+i*(w+gap),ty,w,toolbarh);if(i==0)game_toolbar_item(a,c,t,HIT_GAME_UNDO,CER_ICON_UNDO,"UNDO",0);else if(i==1)game_toolbar_item(a,c,t,HIT_GAME_HINT,CER_ICON_HINT,"HINT",a->hint_from>=0);else if(i==2)game_toolbar_item(a,c,t,HIT_GAME_FLIP,CER_ICON_FLIP,"FLIP",a->flipped);else if(i==3)game_toolbar_item(a,c,t,HIT_GAME_ANALYSIS,CER_ICON_ANALYSIS,"ANALYZE",0);else game_toolbar_item(a,c,t,HIT_GAME_MENU,CER_ICON_MORE,"MORE",0);}}
