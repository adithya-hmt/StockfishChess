static void render_settings(App*a,CerCanvas*c){
    int m=page_margin(c->width),top=topbar_h(c->width)+px(c->width,8);Rect r;draw_topbar(a,c,"SETTINGS",1,0);cer_draw_text(c,m,top,"GAMEPLAY & FEEL",px(c->width,13),muted());
    r=make_rect(m,top+px(c->width,26),c->width-2*m,px(c->width,60));settings_row(a,c,r,HIT_SETTING_HAPTICS,"HAPTICS","Tactile feedback for moves and results.",a->saved.haptics_enabled,0);
    r=make_rect(m,top+px(c->width,94),c->width-2*m,px(c->width,60));settings_row(a,c,r,HIT_SETTING_LEGAL,"LEGAL MOVE DOTS","Show valid destinations after selection.",a->saved.legal_moves_enabled,0);
    r=make_rect(m,top+px(c->width,162),c->width-2*m,px(c->width,60));settings_row(a,c,r,HIT_SETTING_COORDS,"BOARD COORDINATES","Display files and ranks on the board.",a->saved.coordinates_enabled,0);
    r=make_rect(m,top+px(c->width,230),c->width-2*m,px(c->width,60));settings_row(a,c,r,HIT_SETTING_AUTO_QUEEN,"AUTO-QUEEN","Promote to queen without a chooser.",a->saved.auto_queen,0);
    r=make_rect(m,top+px(c->width,298),c->width-2*m,px(c->width,60));settings_row(a,c,r,HIT_SETTING_MOTION,"REDUCE MOTION","Keep transitions short and direct.",a->saved.reduce_motion,0);
    cer_draw_text(c,m,top+px(c->width,383),"APPEARANCE",px(c->width,13),muted());r=make_rect(m,top+px(c->width,409),c->width-2*m,px(c->width,60));settings_row(a,c,r,HIT_SETTING_BOARD,"BOARD THEME","Forest, walnut or ocean squares.",a->saved.board_theme,1);
    r=make_rect(m,top+px(c->width,477),c->width-2*m,px(c->width,60));settings_row(a,c,r,HIT_SETTING_PIECES,"PIECE SET","Original Cerelytic Staunton vectors.",1,0);
    cer_draw_text(c,m,top+px(c->width,562),"LOCAL DATA",px(c->width,13),muted());r=make_rect(m,top+px(c->width,588),c->width-2*m,px(c->width,60));card_outline(c,r,px(c->width,12),surface(),red_dim());cer_draw_icon(c,CER_ICON_RESTART,r.x+px(c->width,29),r.y+r.h/2,px(c->width,22),cer_rgba(255,153,158,255),surface());cer_draw_text(c,r.x+px(c->width,55),r.y+px(c->width,11),"RESET LOCAL DATA",px(c->width,15),cer_rgba(255,190,194,255));cer_draw_text(c,r.x+px(c->width,55),r.y+px(c->width,34),"Profiles, history and settings are erased.",px(c->width,10),muted());hit_add(a,HIT_SETTING_RESET,r);
}

static void overlay_scrim(CerCanvas*c){cer_blend_rect(c,0,0,c->width,c->height,cer_rgba(0,0,0,178));}
static void render_overlay(App*a,CerCanvas*c){
    int m=page_margin(c->width);Rect sheet,r;overlay_scrim(c);
    if(a->overlay==OVERLAY_PROMOTION){int i;char pieces[4]={'Q','R','B','N'};int ids[4]={HIT_PROMO_Q,HIT_PROMO_R,HIT_PROMO_B,HIT_PROMO_N};sheet=make_rect(m,c->height-px(c->width,225),c->width-2*m,px(c->width,205));card_outline(c,sheet,px(c->width,22),surface(),stroke());cer_draw_text(c,sheet.x+px(c->width,20),sheet.y+px(c->width,20),"CHOOSE PROMOTION",px(c->width,20),ink());cer_draw_text(c,sheet.x+px(c->width,20),sheet.y+px(c->width,50),"The pawn earned options. Civilization survives.",px(c->width,11),muted());for(i=0;i<4;++i){int w=(sheet.w-px(c->width,50))/4;r=make_rect(sheet.x+px(c->width,10)+i*(w+px(c->width,10)),sheet.y+px(c->width,83),w,px(c->width,91));cer_fill_round_rect(c,r.x,r.y,r.w,r.h,px(c->width,14),surface2());cer_draw_piece(c,r.x+r.w/2-px(c->width,30),r.y+px(c->width,8),px(c->width,60),a->side_to_move?pieces[i]:(char)(pieces[i]-'A'+'a'));hit_add(a,ids[i],r);}return;}
    if(a->overlay==OVERLAY_GAME_MENU){sheet=make_rect(m,c->height-px(c->width,368),c->width-2*m,px(c->width,348));card_outline(c,sheet,px(c->width,22),surface(),stroke());cer_draw_text(c,sheet.x+px(c->width,20),sheet.y+px(c->width,19),"GAME MENU",px(c->width,21),ink());r=make_rect(sheet.x+px(c->width,14),sheet.y+px(c->width,61),sheet.w-px(c->width,28),px(c->width,50));button(c,r,"RESTART GAME",CER_ICON_RESTART,0);hit_add(a,HIT_GAME_RESTART,r);r=make_rect(sheet.x+px(c->width,14),sheet.y+px(c->width,119),sheet.w-px(c->width,28),px(c->width,50));button(c,r,"EXPORT LAST POSITION",CER_ICON_EXPORT,0);hit_add(a,HIT_GAME_EXPORT,r);r=make_rect(sheet.x+px(c->width,14),sheet.y+px(c->width,177),sheet.w-px(c->width,28),px(c->width,50));button(c,r,"ANALYZE LOCALLY",CER_ICON_ANALYSIS,0);hit_add(a,HIT_GAME_ANALYSIS,r);r=make_rect(sheet.x+px(c->width,14),sheet.y+px(c->width,235),sheet.w-px(c->width,28),px(c->width,50));card_outline(c,r,px(c->width,13),red_dim(),red());cer_draw_icon(c,CER_ICON_RESIGN,r.x+px(c->width,25),r.y+r.h/2,px(c->width,20),cer_rgba(255,197,200,255),red_dim());cer_draw_text(c,r.x+px(c->width,46),r.y+px(c->width,16),"RESIGN",px(c->width,16),cer_rgba(255,197,200,255));hit_add(a,HIT_GAME_RESIGN,r);r=make_rect(sheet.x+px(c->width,14),sheet.y+px(c->width,293),sheet.w-px(c->width,28),px(c->width,37));cer_draw_text_center(c,r.x+r.w/2,r.y+px(c->width,10),"CLOSE",px(c->width,13),muted());hit_add(a,HIT_CANCEL,r);return;}
    if(a->overlay==OVERLAY_CONFIRM_RESIGN||a->overlay==OVERLAY_RESET){const char*title=a->overlay==OVERLAY_RESET?"RESET LOCAL DATA?":"RESIGN THIS GAME?";const char*body=a->overlay==OVERLAY_RESET?"Profiles, games and preferences will be erased.":"The current game will be recorded as a loss.";sheet=make_rect(m,c->height/2-px(c->width,118),c->width-2*m,px(c->width,236));card_outline(c,sheet,px(c->width,20),surface(),red_dim());cer_fill_circle(c,c->width/2,sheet.y+px(c->width,55),px(c->width,28),red_dim());cer_draw_icon(c,a->overlay==OVERLAY_RESET?CER_ICON_RESTART:CER_ICON_RESIGN,c->width/2,sheet.y+px(c->width,55),px(c->width,28),cer_rgba(255,190,194,255),red_dim());cer_draw_text_center(c,c->width/2,sheet.y+px(c->width,96),title,px(c->width,20),ink());cer_draw_text_center(c,c->width/2,sheet.y+px(c->width,128),body,px(c->width,10),muted());r=make_rect(sheet.x+px(c->width,14),sheet.y+px(c->width,161),(sheet.w-px(c->width,36))/2,px(c->width,50));button(c,r,"CANCEL",0,0);hit_add(a,HIT_CANCEL,r);r=make_rect(sheet.x+px(c->width,22)+(sheet.w-px(c->width,36))/2,sheet.y+px(c->width,161),(sheet.w-px(c->width,36))/2,px(c->width,50));card(c,r,px(c->width,13),red());cer_draw_text_center(c,r.x+r.w/2,r.y+px(c->width,16),a->overlay==OVERLAY_RESET?"RESET":"RESIGN",px(c->width,16),ink());hit_add(a,a->overlay==OVERLAY_RESET?HIT_SETTING_RESET:HIT_CONFIRM_RESIGN,r);return;}
    if(a->overlay==OVERLAY_PROFILE_PICKER){int i;sheet=make_rect(m,c->height-px(c->width,122+a->saved.profile_count*70),c->width-2*m,px(c->width,102+a->saved.profile_count*70));card_outline(c,sheet,px(c->width,22),surface(),stroke());cer_draw_text(c,sheet.x+px(c->width,19),sheet.y+px(c->width,18),"LOCAL PROFILES",px(c->width,20),ink());for(i=0;i<a->saved.profile_count;++i){CerProfile*p=&a->saved.profiles[i];r=make_rect(sheet.x+px(c->width,12),sheet.y+px(c->width,54)+i*px(c->width,62),sheet.w-px(c->width,24),px(c->width,54));cer_fill_round_rect(c,r.x,r.y,r.w,r.h,px(c->width,12),i==a->saved.active_profile?green_dim():surface2());cer_draw_avatar(c,r.x+px(c->width,7),r.y+px(c->width,7),px(c->width,40),p->avatar,accent_for(p->accent),surface3());cer_draw_text(c,r.x+px(c->width,57),r.y+px(c->width,10),p->name,px(c->width,15),ink());{char n[20];int_text(p->rating,n,sizeof(n));append_text(n,sizeof(n)," RATING");cer_draw_text(c,r.x+px(c->width,57),r.y+px(c->width,31),n,px(c->width,10),muted());}if(i==a->saved.active_profile)cer_draw_icon(c,CER_ICON_CHECK,r.x+r.w-px(c->width,24),r.y+r.h/2,px(c->width,17),mint(),green_dim());hit_add(a,HIT_PROFILE_BASE+i,r);}r=make_rect(sheet.x+px(c->width,12),sheet.y+sheet.h-px(c->width,42),sheet.w-px(c->width,24),px(c->width,32));cer_draw_text_center(c,r.x+r.w/2,r.y+px(c->width,8),"CLOSE",px(c->width,13),muted());hit_add(a,HIT_CANCEL,r);return;}
    if(a->overlay==OVERLAY_RESULT){
        const CerProfile*p=cer_active_profile_const(&a->saved);int profile_outcome=profile_result(a,a->result);uint32_t tone=a->result_reason==REASON_MATE?red():(profile_outcome==1?green():(profile_outcome==3?red():gold()));const char*heading=a->result_reason==REASON_MATE?"CHECKMATE":(a->result_reason==REASON_TIMEOUT?"TIMEOUT":(a->result==RESULT_DRAW?"DRAW":"GAME OVER"));const char*outcome=profile_outcome==1?"YOU WIN":(profile_outcome==3?"YOU LOST":"GAME DRAWN");
        sheet=make_rect(m,c->height-px(c->width,335),c->width-2*m,px(c->width,315));card_outline(c,sheet,px(c->width,24),surface(),a->result_reason==REASON_MATE?red_dim():stroke());cer_fill_circle(c,c->width/2,sheet.y+px(c->width,52),px(c->width,31),a->result_reason==REASON_MATE?red_dim():green_dim());cer_draw_icon(c,a->result_reason==REASON_MATE?CER_ICON_RESIGN:CER_ICON_TROPHY,c->width/2,sheet.y+px(c->width,52),px(c->width,31),a->result_reason==REASON_MATE?cer_rgba(255,194,198,255):mint(),a->result_reason==REASON_MATE?red_dim():green_dim());cer_draw_text_center(c,c->width/2,sheet.y+px(c->width,96),heading,px(c->width,24),tone);cer_draw_text_center(c,c->width/2,sheet.y+px(c->width,128),outcome,px(c->width,15),ink());if(p){char n[24];int_text(p->rating,n,sizeof(n));append_text(n,sizeof(n)," LOCAL RATING");cer_draw_text_center(c,c->width/2,sheet.y+px(c->width,153),n,px(c->width,11),muted());}
        r=make_rect(sheet.x+px(c->width,14),sheet.y+px(c->width,184),(sheet.w-px(c->width,36))/2,px(c->width,49));button(c,r,"REMATCH",CER_ICON_RESTART,1);hit_add(a,HIT_GAME_REMATCH,r);r=make_rect(sheet.x+px(c->width,22)+(sheet.w-px(c->width,36))/2,sheet.y+px(c->width,184),(sheet.w-px(c->width,36))/2,px(c->width,49));button(c,r,"ANALYZE",CER_ICON_ANALYSIS,0);hit_add(a,HIT_GAME_ANALYSIS,r);r=make_rect(sheet.x+px(c->width,14),sheet.y+px(c->width,242),(sheet.w-px(c->width,36))/2,px(c->width,49));button(c,r,"EXPORT",CER_ICON_EXPORT,0);hit_add(a,HIT_GAME_EXPORT,r);r=make_rect(sheet.x+px(c->width,22)+(sheet.w-px(c->width,36))/2,sheet.y+px(c->width,242),(sheet.w-px(c->width,36))/2,px(c->width,49));button(c,r,"HOME",CER_ICON_HOME,0);hit_add(a,HIT_GAME_HOME,r);return;
    }
}

static void render_screen(App*a,CerCanvas*c){
    draw_background(c);hit_reset(a);
    switch(a->screen){
        case SCR_SPLASH:render_splash(a,c);break;
        case SCR_ONBOARD:render_onboard(a,c);break;
        case SCR_PROFILE_CREATE:render_profile_create(a,c);break;
        case SCR_PIN:render_pin(a,c,0);break;
        case SCR_UNLOCK:render_pin(a,c,1);break;
        case SCR_HOME:render_home(a,c);break;
        case SCR_PLAY:render_play(a,c);break;
        case SCR_GAME:render_game_screen(a,c,0);break;
        case SCR_PUZZLES:render_puzzles(a,c);break;
        case SCR_PUZZLE_GAME:render_game_screen(a,c,1);break;
        case SCR_HISTORY:render_history(a,c);break;
        case SCR_REPLAY:render_replay(a,c);break;
        case SCR_ANALYSIS:render_analysis(a,c);break;
        case SCR_PROFILE:render_profile(a,c);break;
        case SCR_SETTINGS:render_settings(a,c);break;
        default:render_home(a,c);break;
    }
    if(a->overlay!=OVERLAY_NONE)render_overlay(a,c);
    draw_toast(a,c,a->screen==SCR_HOME||a->screen==SCR_PLAY||a->screen==SCR_PUZZLES||a->screen==SCR_HISTORY||a->screen==SCR_PROFILE);
}

static void draw(App*a){ANativeWindow_Buffer b;CerCanvas c;if(!a||!a->window)return;if(ANativeWindow_lock(a->window,&b,0)!=0)return;c.width=b.width;c.height=b.height;c.stride=b.stride;c.bits=b.bits;render_screen(a,&c);ANativeWindow_unlockAndPost(a->window);}
