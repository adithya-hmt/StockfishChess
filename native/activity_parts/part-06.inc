static const char* history_result_label(const CerHistory*h){return h->result==1?"WIN":(h->result==2?"DRAW":"LOSS");}
static uint32_t history_result_color(const CerHistory*h){return h->result==1?green():(h->result==2?gold():red());}
static void render_history(App*a,CerCanvas*c){
    int m=page_margin(c->width),top=topbar_h(c->width)+px(c->width,8),i;Rect r;char n[20],sub[50];draw_topbar(a,c,"HISTORY",0,1);
    cer_draw_text(c,m,top,"SAVED ON THIS DEVICE",px(c->width,13),muted());
    if(a->saved.history_count==0){r=make_rect(m,top+px(c->width,48),c->width-2*m,px(c->width,230));card(c,r,px(c->width,18),surface());cer_fill_circle(c,c->width/2,r.y+px(c->width,76),px(c->width,40),surface3());cer_draw_icon(c,CER_ICON_HISTORY,c->width/2,r.y+px(c->width,76),px(c->width,38),muted(),surface3());cer_draw_text_center(c,c->width/2,r.y+px(c->width,136),"NO GAMES YET",px(c->width,20),ink());cer_draw_text_center(c,c->width/2,r.y+px(c->width,169),"Finished games appear here for replay.",px(c->width,11),muted());}
    for(i=0;i<a->saved.history_count&&i<7;++i){CerHistory*h=&a->saved.history[i];r=make_rect(m,top+px(c->width,35)+i*px(c->width,79),c->width-2*m,px(c->width,68));card(c,r,px(c->width,13),surface());pill(c,make_rect(r.x+px(c->width,10),r.y+px(c->width,14),px(c->width,56),px(c->width,29)),history_result_label(h),cer_rgba((history_result_color(h)&255u),(history_result_color(h)>>8)&255u,(history_result_color(h)>>16)&255u,70),history_result_color(h));cer_copy_text(sub,sizeof(sub),h->mode==MODE_LOCAL?"PASS & PLAY":"VS STOCKFISH / ");if(h->mode!=MODE_LOCAL)append_text(sub,sizeof(sub),level_name(h->level));cer_draw_text(c,r.x+px(c->width,79),r.y+px(c->width,10),sub,px(c->width,14),ink());int_text(h->move_count,n,sizeof(n));append_text(n,sizeof(n)," PLIES");cer_draw_text(c,r.x+px(c->width,79),r.y+px(c->width,35),n,px(c->width,10),muted());cer_draw_icon(c,CER_ICON_CHEVRON,r.x+r.w-px(c->width,23),r.y+r.h/2,px(c->width,15),muted(),surface());hit_add(a,HIT_HISTORY_BASE+i,r);}
    draw_bottom_nav(a,c,TAB_HISTORY);
}

