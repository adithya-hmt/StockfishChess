static void settings_row(App*a,CerCanvas*c,Rect r,int id,const char*title,const char*sub,int on,int cycle){card(c,r,px(c->width,12),surface());cer_draw_text(c,r.x+px(c->width,15),r.y+px(c->width,11),title,px(c->width,15),ink());cer_draw_text(c,r.x+px(c->width,15),r.y+px(c->width,33),sub,px(c->width,10),muted());if(cycle){pill(c,make_rect(r.x+r.w-px(c->width,74),r.y+px(c->width,14),px(c->width,60),px(c->width,30)),on==0?"FOREST":(on==1?"WALNUT":"OCEAN"),surface3(),ink());}else toggle(c,make_rect(r.x+r.w-px(c->width,58),r.y+px(c->width,15),px(c->width,44),px(c->width,26)),on);hit_add(a,id,r);}
